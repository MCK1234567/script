local EFFECT_BASES = { "ParticleEmitter", "Trail", "Beam", "Fire", "Smoke", "Sparkles", "PostEffect" }
local WEAK_KEYS = { __mode = "k" }

local CFG = {
	SafeMode = false,              -- Safe Mode: tránh đụng gameplay
	BudgetMs = 1.5,               -- ngân sách xử lý tối đa mỗi frame (ms)
	MaxQueue = 60000,             -- giới hạn hàng đợi sự kiện
	TickInterval = 1,             -- chu kỳ của vòng lặp duy nhất (giây)
	MemorySampleSec = 5,          -- chu kỳ đo Lua memory
	MemoryHistory = 120,          -- số mẫu giữ lại (~10 phút nếu 5s/mẫu)
	MemoryMinSamples = 12,        -- tối thiểu để phân tích
	EffectSampleSec = 10,         -- chu kỳ phân tích tăng trưởng hiệu ứng
	EffectHistory = 60,
	EffectGrowthWarnPerMin = 120, -- ngưỡng cảnh báo (hiệu ứng/phút)
	LingerMinAge = 90,            -- tuổi tối thiểu (giây) để coi là "tồn đọng"
	RescanSec = 120,              -- kiểm tra đối chiếu tần suất thấp
}

