--==============================================================
-- 18. TICKER (MỘT vòng lặp duy nhất, luôn có task.wait)
--==============================================================
local function tickerLoop()
	local last = { mem = 0, fx = 0, rescan = os.clock() }
	while Core.alive do
		task.wait(CFG.TickInterval)
		if not Core.alive then break end
		local now = os.clock()

		if Mem.enabled and now - last.mem >= CFG.MemorySampleSec then
			last.mem = now
			pcall(Mem.sample)
		end
		if Fx.enabled and now - last.fx >= CFG.EffectSampleSec then
			last.fx = now
			pcall(Fx.analyze)
		end
		if Fx.enabled and now - last.rescan >= CFG.RescanSec then
			last.rescan = now
			if not Scan.active then pcall(Scan.request) end
		end
		if Perf.enabled then pcall(Perf.sample, now) end
		if GUI and GUI.Enabled then pcall(UI.refresh) end

		Perf.selfTime += os.clock() - now
	end
end

