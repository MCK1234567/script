--==============================================================
-- 3. CONNECTION REGISTRY (quản lý & đếm connection do script tạo)
--==============================================================
local Conn = { list = {}, n = 0 }

function Conn.add(tag, connection)
	local bucket = Conn.list[tag]
	if not bucket then
		bucket = {}
		Conn.list[tag] = bucket
	end
	bucket[connection] = true
	Conn.n += 1
	return connection
end

function Conn.remove(tag, connection)
	local bucket = Conn.list[tag]
	if bucket and bucket[connection] then
		bucket[connection] = nil
		Conn.n -= 1
		pcall(function() connection:Disconnect() end)
	end
end

function Conn.clear(tag)
	local bucket = Conn.list[tag]
	if not bucket then return end
	for connection in pairs(bucket) do
		pcall(function() connection:Disconnect() end)
		Conn.n -= 1
	end
	Conn.list[tag] = nil
end

function Conn.clearAll()
	local tags = {}
	for tag in pairs(Conn.list) do tags[#tags + 1] = tag end
	for _, tag in ipairs(tags) do Conn.clear(tag) end
	Conn.n = 0
end

--==============================================================
-- 4. TASK REGISTRY (phát hiện tác vụ không được giải phóng)
--==============================================================
local Tasks = { alive = 0, names = {} }

function Tasks.spawn(name, fn)
	Tasks.alive += 1
	Tasks.names[name] = (Tasks.names[name] or 0) + 1
	return task.spawn(function()
		local ok, err = pcall(fn)
		Tasks.alive -= 1
		local left = (Tasks.names[name] or 1) - 1
		Tasks.names[name] = left > 0 and left or nil
		if not ok then warn("[SuperOptimizer V3.0] Task '" .. name .. "' lỗi: " .. tostring(err)) end
	end)
end

--==============================================================
-- 5. RESTORE MANAGER
-- Lưu thuộc tính gốc trước khi sửa. Chỉ khôi phục nếu giá trị hiện tại
-- vẫn bằng giá trị mà optimizer đã đặt (không ghi đè thay đổi mới của game).
-- store[obj] = { __owner = "Graphics"|"Effects", [prop] = giá trị gốc }
--==============================================================
local function getProp(obj, prop) return obj[prop] end
local function setProp(obj, prop, value) obj[prop] = value end

local function entryIsEmpty(entry)
	for key in pairs(entry) do
		if key ~= "__owner" then return false end
	end
	return true
end

-- Trả về true nếu đây là lần đầu đối tượng/thuộc tính bị thay đổi.
function Restore.set(owner, obj, prop, value)
	local okRead, current = pcall(getProp, obj, prop)
	if not okRead then return false end

	local entry = Restore.store[obj]
	local had = entry ~= nil and entry[prop] ~= nil

	if had then
		-- Game đã tự đổi giá trị sau khi ta áp dụng -> coi giá trị mới là "gốc".
		local appliedForObject = Restore.applied[obj]
		if not appliedForObject or current ~= appliedForObject[prop] then entry[prop] = current end
	else
		if current == value then return false end -- không cần thay đổi
		if not entry then
			entry = { __owner = owner }
			Restore.store[obj] = entry
			Restore.counts[owner] = (Restore.counts[owner] or 0) + 1
		end
		entry[prop] = current
	end

	if current ~= value then
		local okWrite = pcall(setProp, obj, prop, value)
		if not okWrite then
			if not had then
				entry[prop] = nil
				if entryIsEmpty(entry) then
					Restore.store[obj] = nil
					Restore.counts[owner] = math.max(0, (Restore.counts[owner] or 1) - 1)
				end
			end
			return false
		end
	end

	local appliedForObject = Restore.applied[obj]
	if not appliedForObject then
		appliedForObject = {}
		Restore.applied[obj] = appliedForObject
	end
	appliedForObject[prop] = value
	return not had
end

function Restore.restoreObject(owner, obj)
	local entry = Restore.store[obj]
	if not entry or entry.__owner ~= owner then return end
	for prop, original in pairs(entry) do
		if prop ~= "__owner" then
			local ok, current = pcall(getProp, obj, prop)
			local appliedForObject = Restore.applied[obj]
			if ok and appliedForObject and current == appliedForObject[prop] then
				pcall(setProp, obj, prop, original)
			end
		end
	end
	Restore.store[obj] = nil
	Restore.applied[obj] = nil
	Restore.counts[owner] = math.max(0, (Restore.counts[owner] or 1) - 1)
end

-- Tạo job khôi phục theo lát (chunked). force=true: bỏ qua kiểm tra module đang bật.
function Restore.begin(owner, force, onDone)
	local list, n = {}, 0
	for obj, entry in pairs(Restore.store) do
		if entry.__owner == owner then
			n += 1
			list[n] = obj
		end
	end
	local job = { owner = owner, list = list, n = n, i = 1, force = force, onDone = onDone, done = false }
	if n == 0 then
		job.done = true
		if onDone then pcall(onDone) end
		return job
	end
	Restore.jobs[#Restore.jobs + 1] = job
	Worker.kick()
	return job
end

function Restore.runJob(job, deadline)
	if job.done then return true end
	-- Module được bật lại trong lúc khôi phục: bỏ job, giữ nguyên entry.
	if not job.force and Core.applying[job.owner]() then
		job.done = true
		job.list = {}
		return true
	end
	local list, count = job.list, 0
	while job.i <= job.n do
		local obj = list[job.i]
		list[job.i] = nil
		job.i += 1
		if obj then Restore.restoreObject(job.owner, obj) end
		count += 1
		if deadline and count % 32 == 0 and os.clock() > deadline and job.i <= job.n then
			return false
		end
	end
	job.done = true
	if job.onDone then pcall(job.onDone) end
	return true
end

function Restore.step(deadline)
	local jobs = Restore.jobs
	while jobs[1] do
		if Restore.runJob(jobs[1], deadline) then
			table.remove(jobs, 1)
		else
			return false
		end
	end
	return true
end

-- Khôi phục đồng bộ toàn bộ (dùng cho RESTORE ALL / Unload).
function Restore.flush(owner)
	for _, job in ipairs(Restore.jobs) do
		if job.owner == owner then
			job.force = true
			Restore.runJob(job, nil)
		end
	end
	local job = Restore.begin(owner, true)
	if not job.done then Restore.runJob(job, nil) end
	local kept = {}
	for _, j in ipairs(Restore.jobs) do
		if not j.done then kept[#kept + 1] = j end
	end
	Restore.jobs = kept
end

function Restore.pending()
	local total = 0
	for _, job in ipairs(Restore.jobs) do
		if not job.done then total += job.n - job.i + 1 end
	end
	return total
end

--==============================================================
-- 6. QUEUE (debounce: sự kiện chỉ đẩy vào hàng đợi, xử lý theo lát mỗi frame)
--==============================================================
function Queue.push(obj)
	if Queue.tail - Queue.head >= CFG.MaxQueue then
		Queue.dropped += 1
		return
	end
	Queue.tail += 1
	Queue.items[Queue.tail] = obj
end

function Queue.pop()
	if Queue.head > Queue.tail then return nil end
	local obj = Queue.items[Queue.head]
	Queue.items[Queue.head] = nil
	Queue.head += 1
	if Queue.head > Queue.tail then
		Queue.head, Queue.tail = 1, 0
	end
	return obj
end

function Queue.size()
	return Queue.tail - Queue.head + 1
end

function Queue.clear()
	Queue.items = {}
	Queue.head, Queue.tail = 1, 0
end

--==============================================================
-- 7. PHÂN LOẠI ĐỐI TƯỢNG (cache theo ClassName để tránh IsA lặp lại)
--==============================================================
local classCache = {}

local function infoOf(obj)
	local className = obj.ClassName
	local info = classCache[className]
	if info == nil then
		info = { cat = false, part = false }
		for _, base in ipairs(EFFECT_BASES) do
			if obj:IsA(base) then
				info.cat = base
				break
			end
		end
		if not info.cat and obj:IsA("BasePart") and not obj:IsA("Terrain") then
			info.part = true
		end
		classCache[className] = info
	end
	return info
end

-- Safe Mode: hiệu ứng nằm trong model có Humanoid (nhân vật/NPC) được bảo vệ.
local function inCharacter(obj)
	local model = obj:FindFirstAncestorOfClass("Model")
	local guard = 0
	while model and guard < 6 do
		if model:FindFirstChildOfClass("Humanoid") then return true end
		local parent = model.Parent
		model = parent and parent:FindFirstAncestorOfClass("Model") or nil
		guard += 1
	end
	return false
end

--==============================================================
-- 8. GRAPHICS OPTIMIZER
-- Safe: tắt đổ bóng toàn cục, CastShadow, PostEffect, trang trí terrain, sóng nước.
-- Aggressive (Safe Mode OFF): thêm Material=SmoothPlastic, Reflectance=0,
--   giảm ánh sáng môi trường, hạ QualityLevel (nếu client cho phép).
-- Không Destroy, không đụng Transparency/CanCollide/Anchored.
--==============================================================
local function applyGlobalGraphics()
	Restore.set("Graphics", Lighting, "GlobalShadows", false)

	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		Restore.set("Graphics", terrain, "Decoration", false)
		Restore.set("Graphics", terrain, "WaterWaveSize", 0)
		Restore.set("Graphics", terrain, "WaterWaveSpeed", 0)
	end

	if not CFG.SafeMode then
		Restore.set("Graphics", Lighting, "EnvironmentDiffuseScale", 0)
		Restore.set("Graphics", Lighting, "EnvironmentSpecularScale", 0)
		local okR, rendering = pcall(function() return settings().Rendering end)
		if okR and rendering then
			Restore.set("Graphics", rendering, "QualityLevel", Enum.QualityLevel.Level01)
		end
	end
end

local function applyGraphicsToPart(part)
	Restore.set("Graphics", part, "CastShadow", false)
	if not CFG.SafeMode then
		Restore.set("Graphics", part, "Material", Enum.Material.SmoothPlastic)
		Restore.set("Graphics", part, "Reflectance", 0)
	end
end

function Gr.set(enabled)
	enabled = enabled and true or false
	if enabled == Gr.enabled then return end
	Gr.enabled = enabled
	if enabled then
		applyGlobalGraphics()
		Watch.acquire("Graphics")
		Scan.request()
	else
		Watch.release("Graphics")
		Restore.begin("Graphics", false)
	end
end

--==============================================================
-- 9. ADVANCED EFFECT MANAGER
-- Theo dõi: số hiện tại, tạo mới, bị xóa, tốc độ tăng, đối tượng tồn đọng.
-- Nguồn dữ liệu: DescendantAdded/Removing + 1 lần quét đầu + đối chiếu tần suất thấp.
-- PostEffect được đếm ở đây nhưng chỉ bị tắt bởi module Graphics.
--==============================================================
function Fx.resetTracking()
	Fx.cat = setmetatable({}, WEAK_KEYS)
	Fx.born = setmetatable({}, WEAK_KEYS)
	for _, c in ipairs(EFFECT_BASES) do Fx.live[c] = 0 end
	Fx.liveTotal = 0
	Fx.created, Fx.removed, Fx.discovered, Fx.reconciled, Fx.processed = 0, 0, 0, 0, 0
	Fx.baseline, Fx.baselineTime = nil, nil
	Fx.history = {}
	Fx.lifeEMA, Fx.removedSamples = nil, 0
	Fx.rate, Fx.streak, Fx.warn = 0, 0, nil
	Fx.lingering, Fx.lingerState = nil, "no data"
end
Fx.resetTracking()

function Fx.track(obj, cat, fromEvent)
	if Fx.cat[obj] then return false end
	Fx.cat[obj] = cat
	Fx.born[obj] = os.clock()
	Fx.live[cat] += 1
	Fx.liveTotal += 1
	if fromEvent and Fx.baseline then
		Fx.created += 1
	elseif Fx.baseline then
		Fx.reconciled += 1 -- tìm thấy qua đối chiếu (sự kiện bị lỡ hoặc đang chờ)
	else
		Fx.discovered += 1
	end
	return true
end

function Fx.untrack(obj)
	local cat = Fx.cat[obj]
	if not cat then return end
	local born = Fx.born[obj]
	Fx.cat[obj] = nil
	Fx.born[obj] = nil
	Fx.live[cat] -= 1
	Fx.liveTotal -= 1
	Fx.removed += 1
	if born then
		local life = os.clock() - born
		Fx.lifeEMA = Fx.lifeEMA and (Fx.lifeEMA * 0.9 + life * 0.1) or life
		Fx.removedSamples += 1
	end
end

-- Loại các mục không còn nằm trong game (sự kiện Removing có thể bị lỡ).
function Fx.prune()
	for obj in pairs(Fx.cat) do
		local ok, inGame = pcall(obj.IsDescendantOf, obj, game)
		if not ok or not inGame then Fx.untrack(obj) end
	end
end

function Fx.onScanDone()
	if not Fx.enabled then return end
	Fx.prune()
	if not Fx.baseline then
		Fx.baseline = Fx.liveTotal
		Fx.baselineTime = os.clock()
		Fx.history = { { t = Fx.baselineTime, n = Fx.liveTotal } }
	end
end

-- Phân tích tăng trưởng (gọi theo chu kỳ thấp từ ticker).
function Fx.analyze()
	if not Fx.baseline then return end
	local now = os.clock()
	local h = Fx.history
	h[#h + 1] = { t = now, n = Fx.liveTotal }
	if #h > CFG.EffectHistory then table.remove(h, 1) end

	local count = #h
	if count >= 2 then
		if h[count].n > h[count - 1].n then Fx.streak += 1 else Fx.streak = 0 end
	end

	local back = math.max(1, count - 6)
	local dt = h[count].t - h[back].t
	if count >= 2 and dt > 0 then
		Fx.rate = (h[count].n - h[back].n) / dt * 60
	else
		Fx.rate = 0
	end

	-- Đối tượng tồn đọng: sinh ra SAU baseline và sống lâu hơn nhiều so với tuổi thọ
	-- trung bình của hiệu ứng đã bị xóa. Chỉ là dấu hiệu, KHÔNG phải kết luận leak.
	if Fx.removedSamples >= 20 and Fx.lifeEMA then
		local threshold = math.max(CFG.LingerMinAge, Fx.lifeEMA * 3)
		local c = 0
		for _, born in pairs(Fx.born) do
			if born >= Fx.baselineTime and now - born > threshold then c += 1 end
		end
		Fx.lingering, Fx.lingerState = c, "ok"
	else
		Fx.lingering = nil
		Fx.lingerState = string.format("need data (%d/20 removals)", Fx.removedSamples)
	end

	if Fx.rate > CFG.EffectGrowthWarnPerMin and Fx.streak >= 3 then
		Fx.warn = string.format("Effects +%.0f/min", Fx.rate)
	elseif Fx.lingering and Fx.lingering >= 50 and Fx.streak >= 3 then
		Fx.warn = string.format("Effects lingering: %d", Fx.lingering)
	else
		Fx.warn = nil
	end
end

local function reduceEffect(obj, cat)
	if CFG.SafeMode then
		if cat == "Beam" or cat == "Trail" then return end -- thường là thành phần gameplay
		if inCharacter(obj) then return end
	end
	if Restore.set("Effects", obj, "Enabled", false) then
		Fx.processed += 1
	end
end

function Fx.set(enabled)
	enabled = enabled and true or false
	if enabled == Fx.enabled then return end
	Fx.enabled = enabled
	if enabled then
		Fx.resetTracking()
		Watch.acquire("Effects")
		Scan.request()
	else
		Watch.release("Effects")
		Fx.resetTracking()
		Restore.begin("Effects", false)
	end
end

function Fx.setReduce(value)
	value = value and true or false
	if value == Fx.reduce then return end
	Fx.reduce = value
	if Fx.enabled then
		if value then
			Scan.request()
		else
			Restore.begin("Effects", false)
		end
	end
end

--==============================================================
-- 10. XỬ LÝ ĐỐI TƯỢNG (dùng chung cho sự kiện và quét)
--==============================================================
local function processObject(obj, fromEvent)
	local fxOn, grOn = Fx.enabled, Gr.enabled
	if not (fxOn or grOn) then return end

	local info = infoOf(obj)
	local cat = info.cat
	if cat then
		if fxOn then
			local okIn, inGame = pcall(obj.IsDescendantOf, obj, game)
			if okIn and inGame then
				Fx.track(obj, cat, fromEvent)
				if Fx.reduce and cat ~= "PostEffect" then reduceEffect(obj, cat) end
			end
		end
		if grOn and cat == "PostEffect" then
			Restore.set("Graphics", obj, "Enabled", false)
		end
	elseif info.part and grOn then
		applyGraphicsToPart(obj)
	end
end

--==============================================================
-- 11. WATCH (DescendantAdded / DescendantRemoving, dùng chung, đếm tham chiếu)
--==============================================================
local function onAdded(obj)
	Perf.events += 1
	local info = infoOf(obj)
	local wanted = false
	if info.cat then
		wanted = Fx.enabled or (info.cat == "PostEffect" and Gr.enabled)
	elseif info.part then
		wanted = Gr.enabled
	end
	if wanted then
		Queue.push(obj)
		Worker.kick()
	end
end

local function onRemoving(obj)
	if Fx.enabled and Fx.cat[obj] then Fx.untrack(obj) end
end

function Watch.acquire(owner)
	if Watch.users[owner] then return end
	Watch.users[owner] = true
	Watch.n += 1
	if Watch.n == 1 then
		Conn.add("Watch", Workspace.DescendantAdded:Connect(onAdded))
		Conn.add("Watch", Workspace.DescendantRemoving:Connect(onRemoving))
		Conn.add("Watch", Lighting.DescendantAdded:Connect(onAdded))
		Conn.add("Watch", Lighting.DescendantRemoving:Connect(onRemoving))
	end
end

function Watch.release(owner)
	if not Watch.users[owner] then return end
	Watch.users[owner] = nil
	Watch.n -= 1
	if Watch.n <= 0 then
		Watch.n = 0
		Conn.clear("Watch")
		Queue.clear()
	end
end

--==============================================================
-- 12. SCAN (quét theo lát, chỉ khi bật module / đối chiếu định kỳ)
--==============================================================
function Scan.begin()
	Scan.active = true
	Scan.again = false
	local okW, wsList = pcall(function() return Workspace:GetDescendants() end)
	local okL, ltList = pcall(function() return Lighting:GetDescendants() end)
	Scan.lists = { okW and wsList or {}, okL and ltList or {} }
	Scan.li, Scan.i, Scan.done = 1, 1, 0
	Scan.total = #Scan.lists[1] + #Scan.lists[2]
end

function Scan.request()
	if not Core.alive then return end
	if Scan.active then
		Scan.again = true
	else
		Scan.begin()
	end
	Worker.kick()
end

function Scan.finish()
	Scan.active = false
	Scan.lists = {}
	pcall(Fx.onScanDone)
	if Scan.again and Core.alive then Scan.begin() end
end

function Scan.step(deadline)
	local count = 0
	while Scan.active do
		local list = Scan.lists[Scan.li]
		if not list then
			Scan.finish()
			return
		end
		local obj = list[Scan.i]
		if obj == nil then
			Scan.lists[Scan.li] = false
			Scan.li += 1
			Scan.i = 1
		else
			list[Scan.i] = nil
			Scan.i += 1
			Scan.done += 1
			pcall(processObject, obj, false)
			count += 1
			if count % 32 == 0 and os.clock() > deadline then return end
		end
	end
end

function Scan.reset()
	Scan.active = false
	Scan.again = false
	Scan.lists = {}
	Scan.done, Scan.total = 0, 0
end

--==============================================================
-- 13. WORKER (Heartbeat chỉ tồn tại khi còn việc; tự ngắt khi rảnh)
-- Ngân sách mỗi frame giảm 60% nếu frame đang chậm (dt > 50ms).
--==============================================================
function Worker.hasWork()
	return Queue.size() > 0 or Scan.active or #Restore.jobs > 0
end

function Worker.kick()
	if Worker.conn or not Core.alive then return end
	Worker.conn = Conn.add("Worker", RunService.Heartbeat:Connect(Worker.step))
end

function Worker.stop()
	if Worker.conn then
		Conn.remove("Worker", Worker.conn)
		Worker.conn = nil
	end
end

function Worker.step(dt)
	if not Core.alive then
		Worker.stop()
		return
	end
	local t0 = os.clock()
	local budget = CFG.BudgetMs / 1000
	if dt > 0.05 then budget = budget * 0.4 end
	local deadline = t0 + budget

	pcall(Restore.step, deadline)

	if os.clock() < deadline then
		local n = 0
		while true do
			local obj = Queue.pop()
			if obj == nil then break end
			pcall(processObject, obj, true)
			n += 1
			if n % 16 == 0 and os.clock() > deadline then break end
		end
	end

	if Scan.active and os.clock() < deadline then
		pcall(Scan.step, deadline)
	end

	Perf.selfTime += os.clock() - t0
	if not Worker.hasWork() then Worker.stop() end
end

--==============================================================
-- 14. MEMORY LEAK DETECTOR
-- Chỉ đo Lua heap nếu môi trường hỗ trợ collectgarbage("count").
-- KHÔNG gồm texture/mesh/âm thanh/bộ nhớ engine. Không tự gọi GC.
-- Phân biệt: tăng tạm thời (spike) vs tăng liên tục (đáy sau GC tăng dần).
--==============================================================
-- Delta/Roblox client không phải lúc nào cũng cung cấp collectgarbage.
-- Kiểm tra tồn tại trước khi gọi để tránh pcall(nil, ...).
local function readLuaKB()
	if type(collectgarbage) ~= "function" then return nil end
	local ok, v = pcall(collectgarbage, "count")
	if ok and type(v) == "number" then return v end
	return nil
end

function Mem.reset()
	Mem.kb, Mem.t = {}, {}
	Mem.state, Mem.detail, Mem.slope, Mem.troughs = "Collecting", "", 0, 0
end
Mem.reset()

function Mem.analyze()
	local kb, t = Mem.kb, Mem.t
	local n = #kb
	if n < CFG.MemoryMinSamples then
		Mem.state = "Collecting"
		Mem.detail = string.format("%d/%d samples", n, CFG.MemoryMinSamples)
		return
	end

	-- Hồi quy tuyến tính: độ dốc MB/phút
	local sx, sy, sxx, sxy = 0, 0, 0, 0
	local t0 = t[1]
	for i = 1, n do
		local x = (t[i] - t0) / 60
		local y = kb[i] / 1024
		sx += x; sy += y; sxx += x * x; sxy += x * y
	end
	local denom = n * sxx - sx * sx
	Mem.slope = denom ~= 0 and (n * sxy - sx * sy) / denom or 0

	-- Các "đáy" (sau khi GC thu hồi)
	local troughs = {}
	for i = 2, n - 1 do
		if kb[i] < kb[i - 1] and kb[i] <= kb[i + 1] then troughs[#troughs + 1] = kb[i] end
	end
	Mem.troughs = #troughs
	local spanMin = (t[n] - t[1]) / 60

	local rising = false
	if #troughs >= 3 then
		local half = math.floor(#troughs / 2)
		local s1, s2 = 0, 0
		for i = 1, half do s1 += troughs[i] end
		for i = #troughs - half + 1, #troughs do s2 += troughs[i] end
		local m1, m2 = s1 / half, s2 / half
		local up = 0
		for i = 1, #troughs - 1 do
			if troughs[i + 1] >= troughs[i] * 0.995 then up += 1 end
		end
		local frac = up / (#troughs - 1)
		rising = (m2 - m1) >= math.max(3072, m1 * 0.05) and frac >= 0.6 and Mem.slope > 0
	else
		-- Chưa thấy GC thu hồi: xét tăng đơn điệu kéo dài
		local nonDec = 0
		for i = 2, n do
			if kb[i] >= kb[i - 1] then nonDec += 1 end
		end
		rising = (kb[n] - kb[1]) >= 5120 and nonDec / (n - 1) >= 0.85 and Mem.slope > 0
	end

	if rising then
		Mem.state = spanMin >= 3 and "Rising (sustained)" or "Possible rise"
	else
		local sorted = table.clone(kb)
		table.sort(sorted)
		local median = sorted[math.ceil(n / 2)]
		if kb[n] > median * 1.2 then
			Mem.state = "Temporary spike"
		else
			Mem.state = "Stable"
		end
	end
	Mem.detail = string.format("%+.2f MB/min, troughs %d, %.1f min", Mem.slope, Mem.troughs, spanMin)
end

function Mem.sample()
	-- Đo bộ nhớ tổng của client độc lập với Lua heap.
	if Mem.engineOk then
		local ok, v = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
		if ok and type(v) == "number" then
			Mem.engineMB = v
		else
			Mem.engineOk, Mem.engineMB = false, nil
		end
	end

	-- Lua heap chỉ có thể đo nếu môi trường thực sự cung cấp collectgarbage.
	local kb = readLuaKB()
	if not kb then
		if #Mem.kb == 0 then
			Mem.state = "Unavailable"
			Mem.detail = "Lua heap API không được hỗ trợ; Client total vẫn được đo nếu Stats cho phép."
		end
		return
	end

	Mem.kb[#Mem.kb + 1] = kb
	Mem.t[#Mem.t + 1] = os.clock()
	if #Mem.kb > CFG.MemoryHistory then
		table.remove(Mem.kb, 1)
		table.remove(Mem.t, 1)
	end
	Mem.analyze()
end

function Mem.set(enabled)
	enabled = enabled and true or false
	if enabled == Mem.enabled then return end
	Mem.enabled = enabled
	Mem.reset()
	if enabled then pcall(Mem.sample) else Mem.state = "Off" end
end

-- Chỉ chạy khi người dùng bấm. Dùng để so sánh trước/sau: nếu giảm mạnh -> đó là rác
-- chưa được thu hồi, không phải leak. Có thể không được hỗ trợ trong môi trường.
function Mem.manualGC()
	if type(collectgarbage) ~= "function" then
		Mem.gcResult = "Delta không cung cấp collectgarbage"
		return
	end
	local before = readLuaKB()
	local ok = pcall(collectgarbage, "collect")
	local after = readLuaKB()
	if ok and before and after then
		Mem.gcResult = string.format("%.1f -> %.1f MB (%+.1f)", before / 1024, after / 1024, (after - before) / 1024)
	else
		Mem.gcResult = "collect không được hỗ trợ"
	end
end

--==============================================================
-- 15. PERFORMANCE MONITOR (tự đo overhead của chính script)
--==============================================================
function Perf.reset()
	Perf.frames, Perf.events, Perf.selfTime = 0, 0, 0
	Perf.fps, Perf.selfMsPerSec, Perf.eventsPerSec = 0, 0, 0
	Perf.lastT = os.clock()
	Perf.lastSelf, Perf.lastEvents, Perf.lastFrames = 0, 0, 0
end

function Perf.set(enabled)
	enabled = enabled and true or false
	if enabled == Perf.enabled then return end
	Perf.enabled = enabled
	if enabled then
		Perf.reset()
		Perf.conn = Conn.add("Perf", RunService.Heartbeat:Connect(function()
			Perf.frames += 1
		end))
	else
		Conn.clear("Perf")
		Perf.conn = nil
	end
end

function Perf.sample(now)
	local dt = now - Perf.lastT
	if dt < 0.5 then return end
	Perf.fps = (Perf.frames - Perf.lastFrames) / dt
	Perf.selfMsPerSec = (Perf.selfTime - Perf.lastSelf) / dt * 1000
	Perf.eventsPerSec = (Perf.events - Perf.lastEvents) / dt
	Perf.lastT = now
	Perf.lastFrames, Perf.lastSelf, Perf.lastEvents = Perf.frames, Perf.selfTime, Perf.events
end

--==============================================================
-- 16. CORE (điều khiển tổng)
--==============================================================
Core.applying = {
	Graphics = function() return Gr.enabled end,
	Effects = function() return Fx.enabled and Fx.reduce end,
}

function Core.enableAll()
	Gr.set(true)
	Fx.set(true)
	Mem.set(true)
	Perf.set(true)
end

-- Tắt mọi module; thuộc tính được khôi phục theo lát (không gây hitch).
function Core.disableAll()
	Gr.set(false)
	Fx.set(false)
	Mem.set(false)
	Perf.set(false)
end

-- Khôi phục đồng bộ + dọn toàn bộ dữ liệu nội bộ + ngắt mọi connection của module.
function Core.restoreAll()
	Gr.set(false)
	Fx.set(false)
	Mem.set(false)
	Perf.set(false)
	Restore.flush("Graphics")
	Restore.flush("Effects")
	Restore.store = setmetatable({}, WEAK_KEYS)
	Restore.applied, Restore.counts, Restore.jobs = setmetatable({}, WEAK_KEYS), {}, {}
	Queue.clear()
	Queue.dropped = 0
	Scan.reset()
	Fx.resetTracking()
	Mem.reset()
	Mem.state = "Off"
	Mem.gcResult = "-"
	Perf.reset()
	Watch.users, Watch.n = {}, 0
	Conn.clear("Watch")
	Worker.stop()
end

function Core.setSafe(value)
	value = value and true or false
	if CFG.SafeMode == value then return end
	CFG.SafeMode = value
	-- Khôi phục rồi áp dụng lại theo chế độ mới.
	if Gr.enabled then
		Restore.begin("Graphics", true, function()
			if Core.alive and Gr.enabled then
				applyGlobalGraphics()
				Scan.request()
			end
		end)
	end
	if Fx.enabled and Fx.reduce then
		Restore.begin("Effects", true, function()
			if Core.alive and Fx.enabled and Fx.reduce then Scan.request() end
		end)
	end
end

function Core.unload()
	if not Core.alive then return end
	Core.alive = false
	pcall(Core.restoreAll)
	Conn.clearAll()
	if GUI then pcall(function() GUI:Destroy() end) end
	pcall(function()
		local registry = shared
		if registry and registry.RobloxSuperOptimizer
			and registry.RobloxSuperOptimizer.Version == "3.0" then
			registry.RobloxSuperOptimizer = nil
		end
	end)
end

local function collectWarnings()
	local w = {}
	if Mem.enabled and Mem.state == "Rising (sustained)" then w[#w + 1] = "Lua memory rising" end
	if Fx.enabled and Fx.warn then w[#w + 1] = Fx.warn end
	if Perf.enabled and Perf.fps > 0 and Perf.fps < 15 then w[#w + 1] = "Low FPS" end
	if Queue.dropped > 0 then w[#w + 1] = "Queue overflow" end
	if Tasks.alive > 1 then w[#w + 1] = "Extra tasks: " .. Tasks.alive end
	return w
end

