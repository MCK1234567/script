local function setupDrag(handle, target)
	local dragging, dragStart, startPos, moveConn = false, nil, nil, nil
	Conn.add("GUI", handle.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind ~= Enum.UserInputType.MouseButton1 and kind ~= Enum.UserInputType.Touch then return end
		dragging = true
		dragStart = input.Position
		startPos = target.Position
		if moveConn then Conn.remove("Drag", moveConn) end
		moveConn = Conn.add("Drag", UserInputService.InputChanged:Connect(function(i)
			if not dragging then return end
			if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local delta = i.Position - dragStart
			local vp = GUI and GUI.AbsoluteSize or Vector2.new(800, 600)
			if vp.X <= 0 or vp.Y <= 0 then vp = Vector2.new(800, 600) end
			target.Position = UDim2.fromOffset(
				math.clamp(startPos.X.Offset + delta.X, 0, math.max(0, vp.X - 80)),
				math.clamp(startPos.Y.Offset + delta.Y, 0, math.max(0, vp.Y - 40))
			)
		end))
		local endConn
		endConn = Conn.add("Drag", input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				if moveConn then Conn.remove("Drag", moveConn); moveConn = nil end
				Conn.remove("Drag", endConn)
			end
		end))
	end))
end

