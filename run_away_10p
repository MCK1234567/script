local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local idleLimit = 600 -- Số giây không di chuyển trước khi tự thoát
local moveThreshold = 5 -- Ngưỡng dịch chuyển tối thiểu (studs)

local idleTime = 0
local lastPos = nil

RunService.Heartbeat:Connect(function(dt)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if not lastPos then
        lastPos = root.Position
        return
    end

    local dist = (root.Position - lastPos).Magnitude
    if dist > moveThreshold then
        idleTime = 0
        lastPos = root.Position
    else
        idleTime += dt
        if idleTime >= idleLimit then
            pcall(function()
                game:Shutdown()
            end)
            player:Kick("Bạn đã đứng yên quá lâu!")
        end
    end
end)
